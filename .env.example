WAKE_LANGUAGE=en
WAKE_MAX_SECONDS=3
WAKE_SILENCE_SECONDS=1
WAKE_RMS_THRESHOLD=500
LANGUAGE=zh
SAMPLE_RATE=16000
MAX_RECORD_SECONDS=12
SILENCE_TIMEOUT_SECONDS=5
SILENCE_RMS_THRESHOLD=500
FOLLOW_UP_TIMEOUT_SECONDS=8
STT_MODEL=small
STT_COMPUTE_TYPE=int8
TTS_ENGINE=pyttsx3
ENABLE_TTS=false

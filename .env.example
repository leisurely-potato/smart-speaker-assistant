LLM_PROVIDER=qwen
LLM_API_KEY=
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash
ENABLE_WEB_SEARCH=true
FORCE_WEB_SEARCH=true
SEARCH_STRATEGY=turbo
